{
  "sandbox": {
    "enabled": true,
    "allowedDirectories": [
      "$WORKSPACE"
    ],
    "blockedDirectories": [
      "~/.ssh",
      "~/.aws",
      "~/.gnupg",
      "~/Library/Keychains"
    ],
    "blockedCommands": [
      "sudo *",
      "rm -rf /",
      "chmod 777 *"
    ]
  },
  "yolo": true
}